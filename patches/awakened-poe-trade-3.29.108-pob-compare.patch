--- /dev/null
+++ b/renderer/src/web/price-check/pob-compare/pob-build.ts
@@ -0,0 +1,212 @@
+import { shallowRef } from 'vue'
+import { Host } from '@/web/background/IPC'
+
+export interface PobItem {
+  id: string
+  rarity: string
+  name: string
+  baseType: string
+  implicits: string[]
+  explicits: string[]
+}
+
+export interface PobItemSet {
+  id: string
+  title: string
+  slots: Map<string, PobItem>
+}
+
+export interface PobBuild {
+  xml: string
+  className: string
+  ascendClassName: string
+  level: number
+  mainSkill?: string
+  stats: Map<string, number>
+  itemSets: PobItemSet[]
+  activeItemSet: string
+}
+
+export function extractBuildCode (link: string): { url?: string, code?: string } {
+  link = link.trim()
+  const pobbin = link.match(/^(?:https?:\/\/)?pobb\.in\/(?:u\/[^/]+\/)?([\w-]+)\/?(?:raw)?$/)
+  if (pobbin) return { url: `pobb.in/${pobbin[1]}/raw` }
+  const pastebin = link.match(/^(?:https?:\/\/)?pastebin\.com\/(?:raw\/)?(\w+)\/?$/)
+  if (pastebin) return { url: `pastebin.com/raw/${pastebin[1]}` }
+  if (/^[\w=-]{50,}$/.test(link)) return { code: link }
+  return {}
+}
+
+async function decodeBuildCode (code: string): Promise<string> {
+  const b64 = code.trim().replace(/-/g, '+').replace(/_/g, '/')
+  const bytes = Uint8Array.from(atob(b64), c => c.charCodeAt(0))
+  const stream = new Blob([bytes]).stream().pipeThrough(new DecompressionStream('deflate'))
+  return await new Response(stream).text()
+}
+
+function parseItemText (id: string, text: string): PobItem {
+  const lines = text.split('\n').map(line => line.trim()).filter(line => line.length)
+  const rarity = (lines.shift() ?? '').replace(/^Rarity:\s*/, '').toUpperCase()
+  const name = lines.shift() ?? ''
+  const baseType = (rarity === 'RARE' || rarity === 'UNIQUE' || rarity === 'RELIC')
+    ? (lines.shift() ?? '')
+    : name
+
+  let selectedVariant: number | undefined
+  let selectedAltVariant: number | undefined
+  let implicitsCount = 0
+  let idx = 0
+  for (; idx < lines.length; idx += 1) {
+    const line = lines[idx]
+    const prop = line.match(/^([\w ]+):\s*(.*)$/)
+    if (!prop) break
+    if (prop[1] === 'Selected Variant') selectedVariant = Number(prop[2])
+    if (prop[1] === 'Selected Alt Variant') selectedAltVariant = Number(prop[2])
+    if (prop[1] === 'Implicits') {
+      implicitsCount = Number(prop[2])
+      idx += 1
+      break
+    }
+  }
+
+  const mods: string[] = []
+  for (const line of lines.slice(idx)) {
+    let range = 0.5
+    let keep = true
+    const stripped = line.replace(/\{([^}]*)\}/g, (_, tag: string) => {
+      const [key, value] = tag.split(':')
+      if (key === 'range') range = Number(value)
+      if (key === 'variant' && selectedVariant !== undefined) {
+        const variants = value.split(',').map(Number)
+        keep = variants.includes(selectedVariant) ||
+          (selectedAltVariant !== undefined && variants.includes(selectedAltVariant))
+      }
+      return ''
+    })
+    if (!keep) continue
+    mods.push(resolveRanges(stripped, range))
+  }
+
+  return {
+    id,
+    rarity,
+    name,
+    baseType,
+    implicits: mods.slice(0, implicitsCount),
+    explicits: mods.slice(implicitsCount)
+  }
+}
+
+// "+(30-50) to maximum Mana" with range 0.5 -> "+40 to maximum Mana"
+function resolveRanges (line: string, range: number): string {
+  return line.replace(/\((-?\d+(?:\.\d+)?)-(-?\d+(?:\.\d+)?)\)/g, (_, minStr: string, maxStr: string) => {
+    const min = Number(minStr)
+    const max = Number(maxStr)
+    const value = min + (max - min) * range
+    const decimals = Math.max(
+      minStr.split('.')[1]?.length ?? 0,
+      maxStr.split('.')[1]?.length ?? 0)
+    return decimals
+      ? value.toFixed(decimals)
+      : String(Math.round(value))
+  })
+}
+
+function parseBuildXml (xml: string): PobBuild {
+  const doc = new DOMParser().parseFromString(xml, 'text/xml')
+  const buildEl = doc.querySelector('PathOfBuilding > Build')
+  if (!buildEl) throw new Error('Not a Path of Building export')
+
+  const stats = new Map<string, number>()
+  for (const el of buildEl.querySelectorAll('PlayerStat')) {
+    stats.set(el.getAttribute('stat')!, Number(el.getAttribute('value')))
+  }
+
+  const items = new Map<string, PobItem>()
+  for (const el of doc.querySelectorAll('Items > Item')) {
+    const id = el.getAttribute('id')!
+    // text content also includes <ModRange> children, which have no text
+    items.set(id, parseItemText(id, el.textContent ?? ''))
+  }
+
+  const itemsEl = doc.querySelector('Items')
+  const readSlots = (parent: Element) => {
+    const slots = new Map<string, PobItem>()
+    for (const slot of parent.querySelectorAll(':scope > Slot')) {
+      const item = items.get(slot.getAttribute('itemId') ?? '0')
+      if (item) slots.set(slot.getAttribute('name')!, item)
+    }
+    return slots
+  }
+
+  const itemSets: PobItemSet[] = []
+  for (const el of doc.querySelectorAll('Items > ItemSet')) {
+    itemSets.push({
+      id: el.getAttribute('id')!,
+      title: el.getAttribute('title') || `Item set ${el.getAttribute('id')}`,
+      slots: readSlots(el)
+    })
+  }
+  if (!itemSets.length && itemsEl) {
+    // older exports keep slots directly under <Items>
+    itemSets.push({ id: '1', title: 'Default', slots: readSlots(itemsEl) })
+  }
+
+  const mainGroupIdx = Number(buildEl.getAttribute('mainSocketGroup') ?? 1) - 1
+  const skillsEl = doc.querySelector('Skills')
+  const skillSetEl = skillsEl?.querySelector(`:scope > SkillSet[id="${skillsEl.getAttribute('activeSkillSet')}"]`) ??
+    skillsEl?.querySelector(':scope > SkillSet') ??
+    skillsEl
+  const mainGroup = skillSetEl?.querySelectorAll(':scope > Skill')[mainGroupIdx]
+  const mainSkill = mainGroup?.querySelector('Gem')?.getAttribute('nameSpec') ?? undefined
+
+  return {
+    xml,
+    className: buildEl.getAttribute('className') ?? '',
+    ascendClassName: buildEl.getAttribute('ascendClassName') ?? '',
+    level: Number(buildEl.getAttribute('level') ?? 0),
+    mainSkill,
+    stats,
+    itemSets,
+    activeItemSet: itemsEl?.getAttribute('activeItemSet') ?? itemSets[0]?.id ?? '1'
+  }
+}
+
+const cache = shallowRef<{
+  link: string
+  build?: PobBuild
+  error?: string
+  loading: boolean
+} | null>(null)
+
+export function usePobBuild () {
+  async function load (link: string, force = false) {
+    if (!force && cache.value?.link === link && !cache.value.error) return
+    if (!link.trim()) {
+      cache.value = null
+      return
+    }
+
+    cache.value = { link, loading: true }
+    try {
+      const source = extractBuildCode(link)
+      let code = source.code
+      if (source.url) {
+        const response = await Host.proxy(source.url)
+        if (!response.ok) throw new Error(`HTTP ${response.status}`)
+        code = await response.text()
+      }
+      if (!code) throw new Error('Unrecognized link (expected pobb.in, pastebin or a PoB code)')
+      const build = parseBuildXml(await decodeBuildCode(code))
+      if (cache.value?.link === link) {
+        cache.value = { link, build, loading: false }
+      }
+    } catch (e) {
+      if (cache.value?.link === link) {
+        cache.value = { link, error: (e as Error).message, loading: false }
+      }
+    }
+  }
+
+  return { state: cache, load }
+}
diff --git a/renderer/src/web/price-check/pob-compare/pob-calc.ts b/renderer/src/web/price-check/pob-compare/pob-calc.ts
