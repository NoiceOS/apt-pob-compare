@@ -0,0 +1,206 @@
+<template>
+  <div v-if="widget.pobLink && isComparable(item)" class="mb-4 border border-gray-700 rounded">
+    <button class="w-full flex items-center gap-x-2 bg-gray-900 px-2 py-1 rounded-t text-left"
+      @click="widget.pobCompareCollapsed = !widget.pobCompareCollapsed">
+      <i class="fas" :class="widget.pobCompareCollapsed ? 'fa-chevron-right' : 'fa-chevron-down'" />
+      <span class="flex-1 truncate">PoB Comparison</span>
+      <template v-if="headline.length">
+        <span v-for="stat of headline" :key="stat.stat" :class="diffClass(stat)">
+          {{ stat.short }} {{ signed(stat.percent ?? stat.diff, 1) }}{{ stat.percent != null ? '%' : '' }}
+        </span>
+      </template>
+      <i v-else-if="isBusy" class="fas fa-dna fa-spin" />
+    </button>
+    <div v-if="!widget.pobCompareCollapsed" class="p-2">
+      <div v-if="buildState?.loading" class="text-gray-500">Loading build…</div>
+      <div v-else-if="buildState?.error" class="text-red-400">
+        Could not load the build: {{ buildState.error }}
+        <button class="btn ml-2" @click="reloadBuild">Retry</button>
+      </div>
+      <template v-else-if="build">
+        <template v-if="usePobEngine && !engine?.error">
+          <div v-if="engine?.loading" class="text-gray-500">
+            <i class="fas fa-dna fa-spin" /> Starting Path of Building…
+          </div>
+          <template v-else-if="engine?.info">
+            <div class="flex flex-wrap gap-1 mb-2 text-sm">
+              <select v-if="engine.info.itemSets.length > 1" v-model="itemSetId"
+                class="rounded bg-gray-900 px-1 max-w-full truncate">
+                <option v-for="set of engine.info.itemSets" :key="set.id" :value="set.id">{{ set.title }}</option>
+              </select>
+              <button v-for="slot of calc?.slots ?? []" :key="slot.slot"
+                class="px-2 rounded" :class="slot.slot === selectedSlot?.slot ? 'bg-gray-600' : 'bg-gray-900'"
+                @click="selectedSlotName = slot.slot">{{ slot.label }}</button>
+            </div>
+            <div v-if="calcError" class="text-red-400">{{ calcError }}</div>
+            <div v-else-if="!calc" class="text-gray-500"><i class="fas fa-dna fa-spin" /> Calculating…</div>
+            <div v-else-if="!selectedSlot" class="text-gray-500">The build has no slot for this item.</div>
+            <template v-else>
+              <div class="text-gray-400 mb-2 truncate">
+                Replacing: <span class="text-gray-200">{{ selectedSlot.replacing ?? 'empty slot' }}</span>
+              </div>
+              <div v-if="!selectedSlot.stats.length" class="text-gray-500">No change to the build's stats.</div>
+              <table v-else class="w-full text-sm">
+                <tbody>
+                  <tr v-for="stat of selectedSlot.stats" :key="stat.stat + stat.label" :class="diffClass(stat)">
+                    <td class="pr-2 align-top">{{ stat.label }}</td>
+                    <td class="text-right align-top whitespace-nowrap font-poe text-gray-400">
+                      {{ formatStat(stat, stat.before) }} → {{ formatStat(stat, stat.after) }}
+                    </td>
+                    <td class="text-right align-top whitespace-nowrap font-poe pl-2">
+                      {{ formatStat(stat, stat.diff, true) }}
+                    </td>
+                    <td class="text-right align-top whitespace-nowrap font-poe pl-2 w-16">
+                      <template v-if="stat.percent != null">{{ signed(stat.percent, 1) }}%</template>
+                    </td>
+                  </tr>
+                </tbody>
+              </table>
+              <div class="text-gray-600 text-xs mt-2">
+                Calculated by Path of Building · {{ engine.info.ascendClassName || engine.info.className }}
+                lvl {{ engine.info.level }}<template v-if="engine.info.mainSkill"> · {{ engine.info.mainSkill }}</template>
+              </div>
+            </template>
+          </template>
+        </template>
+        <template v-else>
+          <div v-if="engine?.error" class="text-orange-400 text-sm mb-2">
+            <i class="fas fa-exclamation-triangle" /> Path of Building engine failed: {{ engine.error }}
+            <button class="btn ml-2" @click="restartEngine">Retry</button>
+          </div>
+          <div v-else class="text-gray-500 text-xs mb-2">
+            Set the Path of Building folder in settings to get DPS / EHP calculations.
+          </div>
+          <simple-compare :item="item" :build="build" />
+        </template>
+      </template>
+    </div>
+  </div>
+</template>
+
+<script setup lang="ts">
+import { computed, shallowRef, watch } from 'vue'
+import type { ParsedItem } from '@/parser'
+import { AppConfig } from '@/web/Config'
+import type { PriceCheckWidget } from '@/web/overlay/interfaces'
+import { usePobBuild } from './pob-build'
+import { usePobCalc, type PobCompareResult, type PobStatDiff } from './pob-calc'
+import { isComparable } from './compare'
+import SimpleCompare from './SimpleCompare.vue'
+
+const props = defineProps<{
+  item: ParsedItem
+}>()
+
+const widget = computed(() => AppConfig<PriceCheckWidget>('price-check')!)
+const { state: buildState, load: loadBuild } = usePobBuild()
+const { engine, ensureLoaded, compare } = usePobCalc()
+
+const build = computed(() => buildState.value?.build)
+const usePobEngine = computed(() => Boolean(widget.value.pobPath))
+
+watch(() => widget.value.pobLink, (link) => {
+  if (link) loadBuild(link)
+}, { immediate: true })
+
+function reloadBuild () {
+  if (widget.value.pobLink) loadBuild(widget.value.pobLink, true)
+}
+
+watch(() => [build.value, widget.value.pobPath, widget.value.pobLuajit] as const, ([build, pobPath, luajit]) => {
+  if (build && pobPath) ensureLoaded(build.xml, luajit || 'luajit', pobPath)
+}, { immediate: true })
+
+function restartEngine () {
+  if (build.value && widget.value.pobPath) {
+    ensureLoaded(build.value.xml, widget.value.pobLuajit || 'luajit', widget.value.pobPath, true)
+  }
+}
+
+const itemSetId = computed<string>({
+  get () {
+    const info = engine.value?.info
+    const saved = widget.value.pobItemSet
+    return (saved && info?.itemSets.some(set => set.id === saved))
+      ? saved
+      : info?.activeItemSet ?? ''
+  },
+  set (value) { widget.value.pobItemSet = value }
+})
+
+const calc = shallowRef<PobCompareResult | null>(null)
+const calcError = shallowRef<string | null>(null)
+let calcToken = 0
+
+watch(() => [props.item, engine.value?.info, itemSetId.value] as const, async ([item, info, itemSet]) => {
+  calc.value = null
+  calcError.value = null
+  if (!info || !isComparable(item)) return
+  const token = ++calcToken
+  try {
+    const result = await compare(item.rawText.replace(/\r\n/g, '\n'), itemSet)
+    if (token === calcToken) calc.value = result
+  } catch (e) {
+    if (token === calcToken) calcError.value = (e as Error).message
+  }
+}, { immediate: true })
+
+const selectedSlotName = shallowRef('')
+const selectedSlot = computed(() => {
+  const slots = calc.value?.slots ?? []
+  return slots.find(slot => slot.slot === selectedSlotName.value) ?? slots[0]
+})
+
+const HEADLINE = [
+  // most inclusive damage stat first, "average" skills (e.g. Explosive Arrow) don't have DPS
+  {
+    short: 'DPS',
+    stats: [
+      'FullDPS', 'CombinedDPS', 'CombinedAvg',
+      'WithIgniteDPS', 'WithPoisonDPS', 'WithBleedDPS', 'WithImpaleDPS',
+      'TotalDotDPS', 'TotalDPS', 'AverageDamage', 'TotalDot', 'IgniteDPS'
+    ]
+  },
+  { short: 'EHP', stats: ['TotalEHP'] }
+]
+const headline = computed(() => {
+  const stats = selectedSlot.value?.stats ?? []
+  const out: Array<PobStatDiff & { short: string }> = []
+  for (const entry of HEADLINE) {
+    const found = entry.stats.map(name => stats.find(s => s.stat === name)).find(Boolean)
+    if (found) out.push({ ...found, short: entry.short })
+  }
+  return out
+})
+
+const isBusy = computed(() =>
+  buildState.value?.loading || engine.value?.loading ||
+  (engine.value?.info && !calc.value && !calcError.value))
+
+function isImprovement (stat: PobStatDiff) {
+  return (stat.diff > 0) !== stat.lowerIsBetter
+}
+
+function diffClass (stat: PobStatDiff) {
+  return isImprovement(stat) ? 'text-green-400' : 'text-red-400'
+}
+
+function decimalsOf (fmt: string) {
+  const match = fmt.match(/\.(\d)f/)
+  return match ? Number(match[1]) : 0
+}
+
+function signed (value: number, decimals: number) {
+  const str = value.toLocaleString('en-US', { maximumFractionDigits: decimals })
+  return value > 0 ? `+${str}` : str
+}
+
+function formatStat (stat: PobStatDiff, value: number, withSign = false) {
+  const decimals = decimalsOf(stat.fmt)
+  const suffix = stat.fmt.includes('%') ? '%' : ''
+  const str = withSign
+    ? signed(value, decimals)
+    : value.toLocaleString('en-US', { maximumFractionDigits: decimals })
+  return str + suffix
+}
+</script>
diff --git a/renderer/src/web/price-check/pob-compare/SimpleCompare.vue b/renderer/src/web/price-check/pob-compare/SimpleCompare.vue
