@@ -0,0 +1,112 @@
+<template>
+  <div>
+    <div class="flex flex-wrap gap-1 mb-2 text-sm">
+      <select v-if="build.itemSets.length > 1" v-model="itemSetId"
+        class="rounded bg-gray-900 px-1 max-w-full truncate">
+        <option v-for="set of build.itemSets" :key="set.id" :value="set.id">{{ set.title }}</option>
+      </select>
+      <button v-for="slot of slots" :key="slot"
+        class="px-2 rounded" :class="slot === selectedSlot ? 'bg-gray-600' : 'bg-gray-900'"
+        @click="selectedSlot = slot">{{ slot }}</button>
+    </div>
+    <div v-if="itemSetId !== build.activeItemSet" class="text-orange-400 text-sm mb-2">
+      <i class="fas fa-exclamation-triangle" /> Build totals (resistances, attributes, life) come from
+      the active set "{{ activeSetTitle }}", not this one.
+    </div>
+    <div class="text-gray-400 mb-2 truncate">
+      Equipped: <span class="text-gray-200">{{ equipped ? (equipped.name || equipped.baseType) : 'nothing' }}</span>
+    </div>
+    <div v-if="result && !result.rows.length" class="text-gray-500">No stat difference found.</div>
+    <table v-else-if="result" class="w-full text-sm">
+      <tbody>
+        <tr v-for="(row, idx) of result.rows" :key="idx" :class="verdictClass(row.verdict)">
+          <td class="pr-1 align-top w-4"><i class="fas" :class="verdictIcon(row.verdict)" /></td>
+          <td class="pr-2 align-top">
+            {{ row.label }}
+            <div v-if="row.note" class="text-gray-500 text-xs">{{ row.note }}</div>
+          </td>
+          <td class="text-right align-top whitespace-nowrap font-poe">
+            {{ fmt(row.before) }} → {{ fmt(row.after) }}
+            <span class="ml-1">({{ row.delta > 0 ? '+' : '' }}{{ fmt(row.delta) }})</span>
+          </td>
+        </tr>
+      </tbody>
+    </table>
+    <div v-if="result?.unknownPobLines.length" class="text-gray-500 text-xs mt-2"
+      :title="result.unknownPobLines.join('\n')">
+      {{ result.unknownPobLines.length }} unrecognized line(s) on the PoB item, ignored.
+    </div>
+    <div class="text-gray-600 text-xs mt-1">
+      Estimate based on item mods only (no DPS/EHP, no % increased from the tree).
+    </div>
+  </div>
+</template>
+
+<script setup lang="ts">
+import { computed, shallowRef, watch } from 'vue'
+import type { ParsedItem } from '@/parser'
+import { AppConfig } from '@/web/Config'
+import type { PriceCheckWidget } from '@/web/overlay/interfaces'
+import type { PobBuild } from './pob-build'
+import { compareWithBuild, slotsForCategory, type Verdict } from './compare'
+
+const props = defineProps<{
+  item: ParsedItem
+  build: PobBuild
+}>()
+
+const widget = computed(() => AppConfig<PriceCheckWidget>('price-check')!)
+
+const itemSetId = computed<string>({
+  get () {
+    const saved = widget.value.pobItemSet
+    return (saved && props.build.itemSets.some(set => set.id === saved))
+      ? saved
+      : props.build.activeItemSet
+  },
+  set (value) { widget.value.pobItemSet = value }
+})
+const itemSet = computed(() => props.build.itemSets.find(set => set.id === itemSetId.value))
+const activeSetTitle = computed(() =>
+  props.build.itemSets.find(set => set.id === props.build.activeItemSet)?.title)
+
+const slots = computed(() => {
+  const all = slotsForCategory(props.item.category)
+  if (!itemSet.value) return all
+  // hide extra slots (e.g. Ring 3) that the build doesn't use
+  const used = all.filter(slot => itemSet.value!.slots.has(slot))
+  return used.length ? used : all.slice(0, 1)
+})
+
+const selectedSlot = shallowRef('')
+watch(slots, (list) => {
+  if (!list.includes(selectedSlot.value)) selectedSlot.value = list[0] ?? ''
+}, { immediate: true })
+
+const equipped = computed(() => itemSet.value?.slots.get(selectedSlot.value))
+
+const result = computed(() => {
+  if (!selectedSlot.value) return null
+  return compareWithBuild(props.item, equipped.value, props.build)
+})
+
+function fmt (n: number) {
+  return String(Math.round(n * 10) / 10)
+}
+
+function verdictClass (verdict: Verdict) {
+  return {
+    'text-green-400': verdict === 'good',
+    'text-red-400': verdict === 'bad',
+    'text-gray-400': verdict === 'neutral'
+  }
+}
+
+function verdictIcon (verdict: Verdict) {
+  switch (verdict) {
+    case 'good': return 'fa-check'
+    case 'bad': return 'fa-times'
+    default: return 'fa-minus'
+  }
+}
+</script>
diff --git a/renderer/src/web/price-check/pob-compare/compare.ts b/renderer/src/web/price-check/pob-compare/compare.ts
new file mode 100644
index 0000000..d8b50a7
--- /dev/null
+++ b/renderer/src/web/price-check/pob-compare/compare.ts
@@ -0,0 +1,297 @@
+import { StatBetter } from '@/assets/data'
+import type { Stat } from '@/assets/data'
+import { ItemCategory, type ParsedItem } from '@/parser'
+import { ARMOUR, WEAPON } from '@/parser/meta'
+import { ModifierType, sumStatsByModType, type StatCalculated } from '@/parser/modifiers'
+import type { ParsedModifier } from '@/parser/advanced-mod-desc'
+import { linesToStatStrings, tryParseTranslation } from '@/parser/stat-translations'
+import type { PobBuild, PobItem } from './pob-build'
+
+export type Verdict = 'good' | 'bad' | 'neutral'
+
+export interface CompareRow {
+  group: 'defence' | 'resistance' | 'attribute' | 'other'
+  label: string
+  before: number
+  after: number
+  delta: number
+  verdict: Verdict
+  note?: string
+}
+
+export interface CompareResult {
+  rows: CompareRow[]
+  unknownPobLines: string[]
+  good: number
+  bad: number
+}
+
+export function slotsForCategory (category: ItemCategory | undefined): string[] {
+  switch (category) {
+    case ItemCategory.Helmet: return ['Helmet']
+    case ItemCategory.BodyArmour: return ['Body Armour']
+    case ItemCategory.Gloves: return ['Gloves']
+    case ItemCategory.Boots: return ['Boots']
+    case ItemCategory.Belt: return ['Belt']
+    case ItemCategory.Amulet: return ['Amulet']
+    case ItemCategory.Ring: return ['Ring 1', 'Ring 2', 'Ring 3']
+    case ItemCategory.Flask: return ['Flask 1', 'Flask 2', 'Flask 3', 'Flask 4', 'Flask 5']
+    case ItemCategory.Shield:
+    case ItemCategory.Quiver: return ['Weapon 2']
+  }
+  if (category && WEAPON.has(category)) return ['Weapon 1', 'Weapon 2']
+  return []
+}
+
+// Mod type is only used to pick a stat that exists on trade,
+// PoB doesn't tell us much more than "crafted" anyway.
+const MOD_TYPES_TO_TRY = [
+  ModifierType.Explicit,
+  ModifierType.Crafted,
+  ModifierType.Implicit,
+  ModifierType.Enchant,
+  ModifierType.Fractured
+]
+
+function parsePobLines (
+  lines: string[],
+  preferred: ModifierType,
+  category: ItemCategory | undefined,
+  unknown: string[]
+): ParsedModifier {
+  const modifier: ParsedModifier = { info: { type: preferred, tags: [] }, stats: [] }
+  const statIterator = linesToStatStrings(lines)
+  let stat = statIterator.next()
+  while (!stat.done) {
+    let parsed
+    for (const modType of [preferred, ...MOD_TYPES_TO_TRY]) {
+      parsed = tryParseTranslation(stat.value, modType, category)
+      if (parsed) break
+    }
+    if (parsed) {
+      modifier.stats.push(parsed)
+      stat = statIterator.next(true)
+    } else {
+      stat = statIterator.next(false)
+    }
+  }
+  unknown.push(...stat.value)
+  return modifier
+}
+
+interface StatTotal { stat: Stat, value: number }
+
+function totalsFromCalculated (calculated: StatCalculated[]): Map<string, StatTotal> {
+  const out = new Map<string, StatTotal>()
+  for (const calc of calculated) {
+    if (calc.type === ModifierType.Pseudo) continue
+    const value = calc.sources.reduce((sum, source) =>
+      sum + (source.contributes?.value ?? 1), 0)
+    const prev = out.get(calc.stat.ref)
+    out.set(calc.stat.ref, { stat: calc.stat, value: (prev?.value ?? 0) + value })
+  }
+  return out
+}
+
+export function pobItemTotals (item: PobItem | undefined, category: ItemCategory | undefined) {
+  const unknown: string[] = []
+  if (!item) return { totals: new Map<string, StatTotal>(), unknown }
+  const mods = [
+    parsePobLines(item.implicits, ModifierType.Implicit, category, unknown),
+    parsePobLines(item.explicits, ModifierType.Explicit, category, unknown)
+  ]
+  return { totals: totalsFromCalculated(sumStatsByModType(mods)), unknown }
+}
+
+export function parsedItemTotals (item: ParsedItem) {
+  return totalsFromCalculated(item.statsByType)
+}
+
+const RESISTANCES = [
+  { key: 'Fire', label: 'Fire Resistance' },
+  { key: 'Cold', label: 'Cold Resistance' },
+  { key: 'Lightning', label: 'Lightning Resistance' },
+  { key: 'Chaos', label: 'Chaos Resistance' }
+] as const
+
+const RESISTANCE_STATS: Array<{ ref: string, elements: string[] }> = [
+  { ref: '+#% to All Resistances', elements: ['Fire', 'Cold', 'Lightning', 'Chaos'] },
+  { ref: '+#% to all Elemental Resistances', elements: ['Fire', 'Cold', 'Lightning'] },
+  { ref: '+#% to Fire Resistance', elements: ['Fire'] },
+  { ref: '+#% to Cold Resistance', elements: ['Cold'] },
+  { ref: '+#% to Lightning Resistance', elements: ['Lightning'] },
+  { ref: '+#% to Chaos Resistance', elements: ['Chaos'] },
+  { ref: '+#% to Fire and Lightning Resistances', elements: ['Fire', 'Lightning'] },
+  { ref: '+#% to Fire and Cold Resistances', elements: ['Fire', 'Cold'] },
+  { ref: '+#% to Cold and Lightning Resistances', elements: ['Cold', 'Lightning'] },
+  { ref: '+#% to Fire and Chaos Resistances', elements: ['Fire', 'Chaos'] },
+  { ref: '+#% to Cold and Chaos Resistances', elements: ['Cold', 'Chaos'] },
+  { ref: '+#% to Lightning and Chaos Resistances', elements: ['Lightning', 'Chaos'] }
+]
+
+const ATTRIBUTES = [
+  { key: 'Str', label: 'Strength' },
+  { key: 'Dex', label: 'Dexterity' },
+  { key: 'Int', label: 'Intelligence' }
+] as const
+
+const ATTRIBUTE_STATS: Array<{ ref: string, attributes: string[] }> = [
+  { ref: '+# to all Attributes', attributes: ['Str', 'Dex', 'Int'] },
+  { ref: '+# to Strength', attributes: ['Str'] },
+  { ref: '+# to Dexterity', attributes: ['Dex'] },
+  { ref: '+# to Intelligence', attributes: ['Int'] },
+  { ref: '+# to Strength and Intelligence', attributes: ['Str', 'Int'] },
+  { ref: '+# to Strength and Dexterity', attributes: ['Str', 'Dex'] },
+  { ref: '+# to Dexterity and Intelligence', attributes: ['Dex', 'Int'] }
+]
+
+const LIFE_REF = '+# to maximum Life'
+const MANA_REF = '+# to maximum Mana'
+
+const fmt = (n: number) => String(Math.round(n * 10) / 10)
+
+export function compareWithBuild (
+  newItem: ParsedItem,
+  equipped: PobItem | undefined,
+  build: PobBuild
+): CompareResult {
+  const after = parsedItemTotals(newItem)
+  const { totals: before, unknown } = pobItemTotals(equipped, newItem.category)
+  const delta = (ref: string) => (after.get(ref)?.value ?? 0) - (before.get(ref)?.value ?? 0)
+  const pobStat = (name: string) => build.stats.get(name) ?? 0
+  const consumed = new Set<string>([LIFE_REF, MANA_REF])
+  const rows: CompareRow[] = []
+
+  const attrDelta = (key: string) => ATTRIBUTE_STATS
+    .filter(info => info.attributes.includes(key))
+    .reduce((sum, info) => { consumed.add(info.ref); return sum + delta(info.ref) }, 0)
+  const strDelta = attrDelta('Str')
+  const dexDelta = attrDelta('Dex')
+  const intDelta = attrDelta('Int')
+
+  // Flat values only, the build's "% increased" from the tree is unknown here
+  const lifeDelta = delta(LIFE_REF) + Math.floor(strDelta / 2)
+  if (lifeDelta !== 0) {
+    const life = pobStat('Life')
+    rows.push({
+      group: 'defence',
+      label: 'Flat Life',
+      before: life,
+      after: life + lifeDelta,
+      delta: lifeDelta,
+      verdict: lifeDelta > 0 ? 'good' : 'bad',
+      note: life ? `${lifeDelta > 0 ? '+' : ''}${fmt(lifeDelta / life * 100)}% of your Life, before % increased` : undefined
+    })
+  }
+  const manaDelta = delta(MANA_REF) + Math.floor(intDelta / 2)
+  if (manaDelta !== 0) {
+    const mana = pobStat('Mana')
+    rows.push({
+      group: 'defence',
+      label: 'Flat Mana',
+      before: mana,
+      after: mana + manaDelta,
+      delta: manaDelta,
+      verdict: manaDelta > 0 ? 'good' : 'bad'
+    })
+  }
+
+  for (const res of RESISTANCES) {
+    const resDelta = RESISTANCE_STATS
+      .filter(info => info.elements.includes(res.key))
+      .reduce((sum, info) => { consumed.add(info.ref); return sum + delta(info.ref) }, 0)
+    if (resDelta === 0) continue
+
+    const capped = pobStat(`${res.key}Resist`)
+    const overCap = pobStat(`${res.key}ResistOverCap`)
+    const max = overCap > 0 ? capped : Math.max(75, capped)
+    const uncappedBefore = capped + overCap
+    const uncappedAfter = uncappedBefore + resDelta
+    const cappedAfter = Math.min(max, uncappedAfter)
+    const effective = cappedAfter - capped
+
+    let verdict: Verdict
+    let note: string
+    if (effective > 0) {
+      verdict = 'good'
+      note = cappedAfter >= max
+        ? `reaches the cap (${max}%)`
+        : `still ${fmt(max - cappedAfter)}% below the cap`
+    } else if (effective < 0) {
+      verdict = 'bad'
+      note = `${fmt(max - cappedAfter)}% below the cap (${max}%)`
+    } else if (resDelta > 0) {
+      verdict = 'neutral'
+      note = `already capped, overcap ${fmt(overCap)} → ${fmt(uncappedAfter - max)}%`
+    } else {
+      verdict = 'neutral'
+      note = `loss absorbed by overcap (${fmt(uncappedAfter - max)}% left)`
+    }
+    rows.push({
+      group: 'resistance',
+      label: res.label,
+      before: capped,
+      after: cappedAfter,
+      delta: resDelta,
+      verdict,
+      note
+    })
+  }
+
+  const attrDeltas: Record<string, number> = { Str: strDelta, Dex: dexDelta, Int: intDelta }
+  for (const attr of ATTRIBUTES) {
+    const d = attrDeltas[attr.key]
+    if (d === 0) continue
+    const value = pobStat(attr.key)
+    const req = pobStat(`Req${attr.key}`)
+    const next = value + d
+
+    let verdict: Verdict
+    let note: string
+    if (d < 0 && next < req) {
+      verdict = 'bad'
+      note = value >= req
+        ? `drops below requirement (${req})`
+        : `already below requirement (${req}), ${fmt(req - next)} missing`
+    } else if (d > 0 && value < req) {
+      verdict = 'good'
+      note = next >= req
+        ? `meets requirement (${req})`
+        : `helps with requirement (${req}), ${fmt(req - next)} still missing`
+    } else {
+      verdict = 'neutral'
+      note = `requirement (${req}) already met`
+    }
+    rows.push({ group: 'attribute', label: attr.label, before: value, after: next, delta: d, verdict, note })
+  }
+
+  for (const ref of new Set([...before.keys(), ...after.keys()])) {
+    if (consumed.has(ref)) continue
+    const d = delta(ref)
+    if (d === 0) continue
+    const stat = (after.get(ref) ?? before.get(ref))!.stat
+    let verdict: Verdict = 'neutral'
+    if (stat.better === StatBetter.PositiveRoll) verdict = d > 0 ? 'good' : 'bad'
+    if (stat.better === StatBetter.NegativeRoll) verdict = d < 0 ? 'good' : 'bad'
+    rows.push({
+      group: 'other',
+      label: ref,
+      before: before.get(ref)?.value ?? 0,
+      after: after.get(ref)?.value ?? 0,
+      delta: d,
+      verdict
+    })
+  }
+
+  return {
+    rows,
+    unknownPobLines: unknown,
+    good: rows.filter(row => row.verdict === 'good').length,
+    bad: rows.filter(row => row.verdict === 'bad').length
+  }
+}
+
+export function isComparable (item: ParsedItem) {
+  return item.category != null &&
+    (ARMOUR.has(item.category) || WEAPON.has(item.category) || slotsForCategory(item.category).length > 0)
+}
diff --git a/renderer/src/web/price-check/pob-compare/pob-build.ts b/renderer/src/web/price-check/pob-compare/pob-build.ts
