diff --git a/main/src/pob/PobCalc.ts b/main/src/pob/PobCalc.ts
new file mode 100644
index 0000000..9d1c476
--- /dev/null
+++ b/main/src/pob/PobCalc.ts
@@ -0,0 +1,210 @@
+import { spawn, type ChildProcessWithoutNullStreams } from 'node:child_process'
+import fs from 'node:fs'
+import path from 'node:path'
+import { app } from 'electron'
+import type { ServerEvents } from '../server'
+import type { Logger } from '../RemoteLogger'
+import type { PobCalcRequest } from '../../../ipc/types'
+// bundled as text by esbuild
+import bridgeSource from './apt-bridge.lua'
+
+const RESPONSE_PREFIX = '@@APT-POB@@'
+const LOAD_TIMEOUT = 120_000
+const COMPARE_TIMEOUT = 30_000
+
+type LoadRequest = Extract<PobCalcRequest, { cmd: 'load' }>
+
+interface Pending {
+  resolve: (result: unknown) => void
+  reject: (err: Error) => void
+  timer: NodeJS.Timeout
+}
+
+// Runs Path of Building headless (LuaJIT) and keeps it alive between checks,
+// loading a build takes a few seconds, comparing an item is fast.
+export class PobCalc {
+  private proc: ChildProcessWithoutNullStreams | null = null
+  private ready: Promise<void> | null = null
+  private stdoutBuffer = ''
+  private nextId = 1
+  private pending = new Map<number, Pending>()
+  private lastLoad: LoadRequest | null = null
+  private loaded = false
+  private queue = Promise.resolve()
+
+  constructor (
+    private server: ServerEvents,
+    private logger: Logger
+  ) {
+    server.onEventAnyClient('CLIENT->MAIN::pob-calc', (req) => {
+      // requests are serialized, PoB is single-threaded anyway
+      this.queue = this.queue.then(async () => {
+        try {
+          const result = await this.handle(req)
+          this.reply(req.id, { result })
+        } catch (e) {
+          this.reply(req.id, { error: (e as Error).message })
+        }
+      })
+    })
+    app.on('will-quit', () => { this.proc?.kill() })
+  }
+
+  private reply (id: number, payload: { result?: unknown, error?: string }) {
+    this.server.sendEventTo('broadcast', {
+      name: 'MAIN->CLIENT::pob-calc-result',
+      payload: { id, ...payload }
+    })
+  }
+
+  private async handle (req: PobCalcRequest): Promise<unknown> {
+    if (req.cmd === 'load') {
+      const sameEngine = this.lastLoad &&
+        this.lastLoad.luajit === req.luajit &&
+        this.lastLoad.pobPath === req.pobPath
+      if (!sameEngine) this.stop()
+      this.lastLoad = req
+      this.loaded = false
+      return await this.load()
+    }
+
+    if (!this.lastLoad) throw new Error('No build loaded')
+    if (!this.proc || !this.loaded) await this.load()
+    return await this.send({ cmd: 'compare', item: req.item, itemSet: req.itemSet }, COMPARE_TIMEOUT)
+  }
+
+  private async load () {
+    const req = this.lastLoad!
+    await this.start(req.luajit, req.pobPath)
+    const info = await this.send({ cmd: 'load', xml: req.xml }, LOAD_TIMEOUT)
+    this.loaded = true
+    return info
+  }
+
+  private start (luajit: string, pobPath: string): Promise<void> {
+    if (this.proc && this.ready) return this.ready
+
+    const srcDir = path.join(pobPath, 'src')
+    if (!fs.existsSync(path.join(srcDir, 'HeadlessWrapper.lua'))) {
+      return Promise.reject(new Error(`Path of Building not found in "${pobPath}"`))
+    }
+    if (process.platform === 'win32' && !path.isAbsolute(luajit)) {
+      return Promise.reject(new Error('Set the full path to luajit.exe in settings'))
+    }
+    const bridgePath = path.join(app.getPath('userData'), 'apt-pob-bridge.lua')
+    fs.writeFileSync(bridgePath, bridgeSource)
+
+    const runtimeDir = path.join(pobPath, 'runtime')
+    // On Windows, PoB's own DLLs are built for a different LuaJIT build,
+    // so C modules (lua-utf8.dll) must come from the folder of luajit.exe
+    const cpath = (process.platform === 'win32')
+      ? path.join(path.dirname(luajit), '?.dll')
+      : path.join(runtimeDir, '?.so')
+    const proc = spawn(luajit || 'luajit', [bridgePath], {
+      cwd: srcDir,
+      env: {
+        ...process.env,
+        LUA_PATH: `${path.join(runtimeDir, 'lua', '?.lua')};${path.join(runtimeDir, 'lua', '?', 'init.lua')};;`,
+        LUA_CPATH: `${cpath};;`
+      },
+      windowsHide: true
+    })
+    this.proc = proc
+    this.stdoutBuffer = ''
+
+    this.ready = new Promise<void>((resolve, reject) => {
+      const timer = setTimeout(() => {
+        reject(new Error('Path of Building took too long to start'))
+        this.stop()
+      }, LOAD_TIMEOUT)
+      this.pending.set(0, {
+        resolve: () => { resolve() },
+        reject,
+        timer
+      })
+    })
+
+    let stderr = ''
+    proc.stderr.on('data', (chunk: Buffer) => {
+      stderr = (stderr + chunk.toString()).slice(-2000)
+    })
+    proc.stdout.on('data', (chunk: Buffer) => { this.onStdout(chunk.toString()) })
+    proc.on('error', (err) => {
+      this.logger.write(`error [pob-calc] ${err.message}`)
+      this.failAll(new Error(`Cannot start LuaJIT: ${err.message}`))
+      this.reset(proc)
+    })
+    proc.on('exit', (code) => {
+      if (this.proc !== proc) return
+      this.logger.write(`error [pob-calc] exited with code ${code}: ${stderr.trim()}`)
+      this.failAll(new Error(`Path of Building exited (code ${code}) ${stderr.trim().split('\n').pop() ?? ''}`))
+      this.reset(proc)
+    })
+
+    return this.ready
+  }
+
+  private onStdout (text: string) {
+    this.stdoutBuffer += text
+    let idx: number
+    while ((idx = this.stdoutBuffer.indexOf('\n')) !== -1) {
+      const line = this.stdoutBuffer.slice(0, idx)
+      this.stdoutBuffer = this.stdoutBuffer.slice(idx + 1)
+      if (!line.startsWith(RESPONSE_PREFIX)) continue
+
+      let msg: { id?: number, ready?: boolean, result?: unknown, error?: string }
+      try {
+        msg = JSON.parse(line.slice(RESPONSE_PREFIX.length))
+      } catch {
+        continue
+      }
+      const id = msg.ready ? 0 : msg.id
+      const pending = (id != null) ? this.pending.get(id) : undefined
+      if (!pending) continue
+      this.pending.delete(id!)
+      clearTimeout(pending.timer)
+      if (msg.error) {
+        pending.reject(new Error(msg.error))
+      } else {
+        pending.resolve(msg.result)
+      }
+    }
+  }
+
+  private send (payload: object, timeout: number): Promise<unknown> {
+    const proc = this.proc
+    if (!proc) return Promise.reject(new Error('Path of Building is not running'))
+    const id = this.nextId++
+    return new Promise((resolve, reject) => {
+      const timer = setTimeout(() => {
+        this.pending.delete(id)
+        reject(new Error('Path of Building did not respond in time'))
+      }, timeout)
+      this.pending.set(id, { resolve, reject, timer })
+      proc.stdin.write(JSON.stringify({ id, ...payload }) + '\n')
+    })
+  }
+
+  private failAll (err: Error) {
+    for (const pending of this.pending.values()) {
+      clearTimeout(pending.timer)
+      pending.reject(err)
+    }
+    this.pending.clear()
+  }
+
+  private reset (proc: ChildProcessWithoutNullStreams) {
+    if (this.proc !== proc) return
+    this.proc = null
+    this.ready = null
+    this.loaded = false
+  }
+
+  private stop () {
+    const proc = this.proc
+    if (!proc) return
+    this.reset(proc)
+    this.failAll(new Error('Path of Building was restarted'))
+    proc.kill()
+  }
+}
diff --git a/main/src/pob/apt-bridge.lua b/main/src/pob/apt-bridge.lua
new file mode 100644
index 0000000..c40ff37
--- /dev/null
+++ b/main/src/pob/apt-bridge.lua
@@ -0,0 +1,178 @@
+-- Awakened PoE Trade <-> Path of Building bridge.
+-- Must be started with the working directory set to PoB's "src" folder.
+-- Reads one JSON request per line on stdin, writes one JSON response per line
+-- on stdout, prefixed with RESPONSE_PREFIX (PoB itself prints to stdout too).
+
+local RESPONSE_PREFIX = "@@APT-POB@@"
+
+-- PoB's entry scripts start with a "#@" line meant for SimpleGraphic
+local function loadStripped (path)
+	local file = assert(io.open(path, "rb"))
+	local text = file:read("*a"):gsub("^\239\187\191", ""):gsub("^#[^\n]*", "")
+	file:close()
+	return assert(loadstring(text, "@" .. path))
+end
+local l_dofile = dofile
+function dofile (path)
+	if path:match("%.lua$") then
+		return loadStripped(path)()
+	end
+	return l_dofile(path)
+end
+
+local stdout = io.stdout
+local function noop () end
+print = noop
+
+loadStripped("HeadlessWrapper.lua")()
+ConPrintf = noop
+
+local dkjson = require("dkjson")
+
+local function respond (msg)
+	stdout:write(RESPONSE_PREFIX, dkjson.encode(msg), "\n")
+	stdout:flush()
+end
+
+-- copy of the local function in Modules/Build.lua
+local function matchFlags (reqFlags, notFlags, flags)
+	if type(reqFlags) == "string" then reqFlags = { reqFlags } end
+	if reqFlags then
+		for _, flag in ipairs(reqFlags) do
+			if not flags[flag] then return false end
+		end
+	end
+	if type(notFlags) == "string" then notFlags = { notFlags } end
+	if notFlags then
+		for _, flag in ipairs(notFlags) do
+			if flags[flag] then return false end
+		end
+	end
+	return true
+end
+
+local function collectStats (statList, actor, baseOutput, compareOutput, out, prefix)
+	if not statList or not baseOutput or not compareOutput then return end
+	for _, statData in ipairs(statList) do
+		if statData.stat and not statData.childStat and statData.stat ~= "SkillDPS" and
+			matchFlags(statData.flag, statData.notFlag, actor.mainSkill.skillFlags) then
+			local after = compareOutput[statData.stat] or 0
+			local before = baseOutput[statData.stat] or 0
+			if type(after) == "number" and type(before) == "number" then
+				local diff = after - before
+				if statData.stat == "FullDPS" and not compareOutput[statData.stat] then
+					diff = 0
+				end
+				if (diff > 0.001 or diff < -0.001) and
+					(not statData.condFunc or statData.condFunc(after, compareOutput) or statData.condFunc(before, baseOutput)) then
+					local scale = (statData.pc or statData.mod) and 100 or 1
+					table.insert(out, {
+						stat = statData.stat,
+						label = (prefix or "") .. statData.label,
+						before = before * scale,
+						after = after * scale,
+						diff = diff * scale,
+						fmt = statData.fmt,
+						lowerIsBetter = statData.lowerIsBetter or false,
+						percent = (statData.compPercent and before ~= 0 and after ~= 0) and (after / before * 100 - 100) or nil
+					})
+				end
+			end
+		end
+	end
+end
+
+local function selectItemSet (itemSetId)
+	local itemsTab = build.itemsTab
+	itemSetId = tonumber(itemSetId)
+	if itemSetId and itemsTab.itemSets[itemSetId] and itemsTab.activeItemSetId ~= itemSetId then
+		itemsTab:SetActiveItemSet(itemSetId)
+		runCallback("OnFrame")
+	end
+end
+
+local function compareItem (itemText, itemSetId)
+	local itemsTab = build.itemsTab
+	selectItemSet(itemSetId)
+	-- PoB <= 2.67 takes the raw text in the constructor, newer versions use :Item()
+	local ok, item = pcall(new, "Item", itemText)
+	if not ok then
+		item = new("Item"):Item(itemText)
+	end
+	if not item.base then
+		return { error = "Path of Building could not parse this item" }
+	end
+	item:NormaliseQuality()
+	item:BuildModList()
+
+	itemsTab:UpdateSockets()
+	local calcFunc, calcBase = build.calcsTab:GetMiscCalculator()
+	local env = build.calcsTab.mainEnv
+	local slots = { }
+	for slotName, slot in pairs(itemsTab.slots) do
+		if not slot.nodeId and itemsTab:IsItemValidForSlot(item, slotName) and not slot.inactive and
+			(not slot.weaponSet or slot.weaponSet == (itemsTab.activeItemSet.useSecondWeaponSet and 2 or 1)) and
+			slot.shown() then
+			local selItem = itemsTab.items[slot.selItemId]
+			local output = calcFunc({ repSlotName = slotName, repItem = item })
+			local stats = { }
+			if env.player.mainSkill.minion and calcBase.Minion and output.Minion then
+				collectStats(build.minionDisplayStats, env.minion, calcBase.Minion, output.Minion, stats, "Minion: ")
+			end
+			collectStats(build.displayStats, env.player, calcBase, output, stats)
+			table.insert(slots, {
+				slot = slotName,
+				label = slot.label or slotName,
+				replacing = selItem and selItem.name or nil,
+				stats = stats
+			})
+		end
+	end
+	table.sort(slots, function (a, b) return a.slot < b.slot end)
+	return { item = item.name, itemSet = tostring(itemsTab.activeItemSetId), slots = slots }
+end
+
+local function buildInfo ()
+	local mainSkill = build.calcsTab.mainEnv.player.mainSkill
+	local itemsTab = build.itemsTab
+	local itemSets = { }
+	for _, id in ipairs(itemsTab.itemSetOrderList) do
+		local set = itemsTab.itemSets[id]
+		table.insert(itemSets, { id = tostring(id), title = set.title or ("Item set " .. id) })
+	end
+	return {
+		itemSets = itemSets,
+		activeItemSet = tostring(itemsTab.activeItemSetId),
+		className = build.spec.curClassName,
+		ascendClassName = build.spec.curAscendClassName,
+		level = build.characterLevel,
+		mainSkill = mainSkill and mainSkill.activeEffect and mainSkill.activeEffect.grantedEffect.name or nil
+	}
+end
+
+respond({ ready = true })
+
+for line in io.stdin:lines() do
+	local req = dkjson.decode(line)
+	if type(req) == "table" then
+		local ok, result = pcall(function ()
+			if req.cmd == "load" then
+				loadBuildFromXML(req.xml, "APT")
+				if not build.calcsTab or not build.calcsTab.mainEnv then
+					error("Could not load the build")
+				end
+				return buildInfo()
+			elseif req.cmd == "compare" then
+				return compareItem(req.item, req.itemSet)
+			else
+				error("Unknown command: " .. tostring(req.cmd))
+			end
+		end)
+		if ok then
+			respond({ id = req.id, result = result })
+		else
+			respond({ id = req.id, error = tostring(result) })
+		end
+		collectgarbage("collect")
+	end
+end
