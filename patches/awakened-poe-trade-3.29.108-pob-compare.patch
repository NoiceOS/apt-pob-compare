@@ -0,0 +1,101 @@
+import { shallowRef } from 'vue'
+import type { PobCalcRequest } from '@ipc/types'
+import { Host } from '@/web/background/IPC'
+
+export interface PobStatDiff {
+  stat: string
+  label: string
+  before: number
+  after: number
+  diff: number
+  fmt: string
+  lowerIsBetter: boolean
+  percent?: number
+}
+
+export interface PobSlotCompare {
+  slot: string
+  label: string
+  replacing?: string
+  stats: PobStatDiff[]
+}
+
+export interface PobCompareResult {
+  item: string
+  itemSet: string
+  slots: PobSlotCompare[]
+}
+
+export interface PobEngineInfo {
+  className: string
+  ascendClassName: string
+  level: number
+  mainSkill?: string
+  itemSets: Array<{ id: string, title: string }>
+  activeItemSet: string
+}
+
+type RequestWithoutId = PobCalcRequest extends infer R
+  ? R extends PobCalcRequest ? Omit<R, 'id'> : never
+  : never
+
+// other clients (e.g. browser tab) also receive broadcasted results
+let nextId = Math.floor(Math.random() * 1e9)
+const pending = new Map<number, { resolve: (v: unknown) => void, reject: (e: Error) => void }>()
+
+Host.onEvent('MAIN->CLIENT::pob-calc-result', (e) => {
+  const req = pending.get(e.id)
+  if (!req) return
+  pending.delete(e.id)
+  if (e.error) {
+    req.reject(new Error(e.error))
+  } else {
+    req.resolve(e.result)
+  }
+})
+
+function request<T> (req: RequestWithoutId): Promise<T> {
+  const id = nextId++
+  return new Promise<T>((resolve, reject) => {
+    pending.set(id, { resolve: resolve as (v: unknown) => void, reject })
+    Host.sendEvent({ name: 'CLIENT->MAIN::pob-calc', payload: { ...req, id } as PobCalcRequest })
+  })
+}
+
+const engine = shallowRef<{
+  key: string
+  loading: boolean
+  info?: PobEngineInfo
+  error?: string
+} | null>(null)
+
+let loadPromise: Promise<void> | null = null
+
+export function usePobCalc () {
+  async function ensureLoaded (xml: string, luajit: string, pobPath: string, force = false) {
+    const key = `${luajit}\n${pobPath}\n${xml.length}:${xml.slice(-200)}`
+    if (!force && engine.value?.key === key && !engine.value.error) {
+      return await loadPromise
+    }
+    engine.value = { key, loading: true }
+    loadPromise = request<PobEngineInfo>({ cmd: 'load', xml, luajit, pobPath })
+      .then(info => {
+        if (engine.value?.key === key) engine.value = { key, loading: false, info }
+      }, (e: Error) => {
+        if (engine.value?.key === key) engine.value = { key, loading: false, error: e.message }
+      })
+    return await loadPromise
+  }
+
+  async function compare (itemText: string, itemSet?: string) {
+    const result = await request<PobCompareResult>({ cmd: 'compare', item: itemText, itemSet })
+    // Lua encodes empty tables as objects
+    const slots = Array.isArray(result.slots) ? result.slots : []
+    for (const slot of slots) {
+      if (!Array.isArray(slot.stats)) slot.stats = []
+    }
+    return { ...result, slots }
+  }
+
+  return { engine, ensureLoaded, compare }
+}
